{
  "manifest_version": 3,
  "name": "FreeYT",
  "version": "0.1.0",
  "description": "Reloads a YouTube watch page until the video ad is gone.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "src/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/ad-detector.js",
        "src/ad-guard.js",
        "src/app.js",
        "src/main.js",
        "src/retry-policy.js",
        "src/settings.js",
        "src/spa-navigation.js"
      ],
      "matches": [
        "https://www.youtube.com/*"
      ]
    }
  ],
  "permissions": [
    "storage"
  ],
  "action": {
    "default_title": "FreeYT",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    },
    "default_popup": "popup.html"
  }
}
